+# CURL/libcurl are only used by the wxWidgets GUI (network printing, update
+# checks) and by OrcaSlicer_profile_validator (an ORCA_TOOLS dev utility) --
+# never by libslic3r itself. Guarding this behind SLIC3R_GUI/ORCA_TOOLS is
+# what makes a headless (SLIC3R_GUI=OFF) engine-only build possible at all,
+# e.g. for Android, which has no CURL cross-compiled and no use for it.
+if (SLIC3R_GUI OR ORCA_TOOLS)
+    find_package(CURL REQUIRED)
+
+    add_library(libcurl INTERFACE)
+    target_link_libraries(libcurl INTERFACE CURL::libcurl)
+    target_link_libraries(libcurl INTERFACE ZLIB::ZLIB)
+
+    # Fixing curl's cmake config script bugs
+    if (NOT WIN32)
+        # Required by libcurl
