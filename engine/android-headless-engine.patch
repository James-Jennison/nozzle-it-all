diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index f0de57f1..cc17ba62 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -249,6 +249,13 @@ set(output_dlls_RelWithDebInfo "")
 # libpython resolution: rpath on the OrcaSlicer target (above); the dep
 # recipe gives the bundled interpreter a self-relative rpath.
 # --------------------------------------------------------------------------
+# This entire block stages runtime deps (bundled Python, FFmpeg .so's, uv)
+# next to the OrcaSlicer GUI executable. orcaslicer_copy_sos()/
+# orcaslicer_copy_dlls() call file(COPY ...) eagerly at CONFIGURE time (not
+# deferred to build time), so on a SLIC3R_GUI=OFF headless build they fail
+# immediately even though the OrcaSlicer target itself is never built --
+# there is no bundled Python or FFmpeg to stage, nor any reason to.
+if (SLIC3R_GUI)
 if (WIN32)
     # This has to be a separate target due to the windows command line length limits
     add_custom_target(COPY_DLLS ALL DEPENDS OrcaSlicer)
@@ -371,6 +378,7 @@ else ()
             VERBATIM)
     endif()
 endif ()
+endif () # SLIC3R_GUI (runtime dep staging)
 
