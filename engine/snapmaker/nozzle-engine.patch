+//
+// The code is PrusaSlicer's, unchanged except where this engine (Snapmaker Orca cbf7bbb0b3 libslic3r) differs:
+//   - the painted-state type is Snapmaker's EnforcerBlockerType (ExtruderMax = 255) for PrusaSlicer's EnforcerBlockerType
+//     (TRIANGLE_STATE_TYPE_COUNT - 1 = ExtruderMax);
+//   - the region's perimeter extruder is Snapmaker's wall_filament (PrusaSlicer's perimeter_extruder), a LayerRegion's
+//     slices are its public `slices` (PrusaSlicer's m_slices / slices()), a volume's paint is mmu_segmentation_facets;
+//   - remap_virtual_extruders_to_physical indexes the MM segmentation by filament id, because this engine's
+//     multi_material_segmentation_by_painting() keeps channel 0 for the unpainted default (PrusaSlicer's drops it and
+//     indexes by id - 1). The algorithm is otherwise identical.
+#include "VirtualExtruder.hpp"
