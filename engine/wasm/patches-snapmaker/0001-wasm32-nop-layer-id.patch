wasm32: size_t is 32-bit, so coord_t's maximum doesn't fit the nop layer's size_t layer_id (a narrowing error in the
brace initialiser). Saturate at whichever maximum is smaller: unchanged on 64-bit targets. Snapmaker Orca base only
(upstream OrcaSlicer already uses size_t's maximum here).
--- a/src/libslic3r/GCode.hpp
+++ b/src/libslic3r/GCode.hpp
@@ -179,7 +179,7 @@
     // It is used for the pressure equalizer because it needs to buffer one layer back.
     bool        nop_layer_result { false };
 
-    static LayerResult make_nop_layer_result() { return {"", std::numeric_limits<coord_t>::max(), false, false, true}; }
+    static LayerResult make_nop_layer_result() { return {"", size_t(std::min<unsigned long long>(std::numeric_limits<coord_t>::max(), std::numeric_limits<size_t>::max())), false, false, true}; }
 };
 
 class GCode {
