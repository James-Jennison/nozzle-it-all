{
  "name": "Nozzle It All Web",
  "short_name": "Nozzle It All",
  "id": "/?app=nozzle-it-all-web",
  "description": "Prepare, slice and send 3D prints from your browser. Models stay on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0D1114",
  "theme_color": "#0D1114",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/brand/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [{ "action": "/", "accept": { "model/3mf": [".3mf"], "model/stl": [".stl"] } }]
}
