{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": false, "types": ["vite/client"], "isolatedModules": true
  },
  "include": ["src"]
}
